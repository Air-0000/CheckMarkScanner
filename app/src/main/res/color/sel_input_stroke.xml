<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索框描边：必须是带状态的列表，否则 TextInputLayout 只把颜色用于聚焦态 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/line_soft" android:state_enabled="false" />
    <item android:color="@color/line" android:state_focused="true" />
    <item android:color="@color/line" android:state_hovered="true" />
    <item android:color="@color/line" />
</selector>
