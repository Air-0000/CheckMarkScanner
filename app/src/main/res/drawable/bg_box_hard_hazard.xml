<?xml version="1.0" encoding="utf-8"?>
<!-- 重点信息块：黄底 + 右下硬投影 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/hard_shadow" android:top="@dimen/hard_shadow">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_hard" />
        </shape>
    </item>
    <item android:bottom="@dimen/hard_shadow" android:right="@dimen/hard_shadow">
        <shape android:shape="rectangle">
            <solid android:color="@color/hazard" />
            <stroke android:width="@dimen/stroke_regular" android:color="@color/line" />
        </shape>
    </item>
</layer-list>
