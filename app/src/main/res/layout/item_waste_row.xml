<?xml version="1.0" encoding="utf-8"?>
<!-- 废料表识别结果的一行 (WasteActivity 动态添加到 ll_rows)：左侧行号，右侧两行摘要；有待核对的格子时行号为黄底 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_hard"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="13dp"
    android:paddingTop="8dp"
    android:paddingBottom="11dp">

    <TextView
        android:id="@+id/tv_row_no"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_tag_outline"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:textColor="@color/text_main"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_row_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_row_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
