<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/card_bg"
    app:strokeColor="@color/border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 顶部信息栏: 序号、姓名、车牌、Excel行号 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_index"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:background="@drawable/bg_index_circle"
                android:text="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1B5E20" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="郭旺平"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_main" />

            <TextView
                android:id="@+id/tv_plate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="川H9756G"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_excel_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_badge"
                android:text="Excel 第5行"
                android:textSize="11sp"
                android:textColor="#1565C0" />
        </LinearLayout>

        <!-- 勾选与Excel对应摘要 -->
        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:text="已打钩: 周一白(D5), 周二白(F5)"
            android:textSize="12sp"
            android:textColor="#1B5E20" />

        <!-- 14 个班次快捷打钩选择网格 (7列 x 2行) -->
        <GridLayout
            android:id="@+id/grid_shifts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="7"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="false" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
