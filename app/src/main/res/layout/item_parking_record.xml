<?xml version="1.0" encoding="utf-8"?>
<!-- 人员卡片：直角描边 + 右下硬投影，点击时下沉 (点击编辑由 RecordAdapter 绑定) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card_hard"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="13dp"
    android:paddingBottom="13dp">

    <!-- 顶部信息栏: 序号、姓名、车牌、Excel行号 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_index"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:minWidth="26dp"
            android:gravity="center"
            android:background="@drawable/bg_index_box"
            android:fontFamily="sans-serif-condensed"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/on_selected" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="郭旺平"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <TextView
            android:id="@+id/tv_plate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.04"
            android:text="川H9756G"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_excel_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bg_tag_outline"
            android:fontFamily="sans-serif-condensed"
            android:text="Excel 第5行"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />
    </LinearLayout>

    <!-- 勾选与Excel对应摘要 (颜色 / 粗细由 RecordAdapter 按是否打钩设置) -->
    <TextView
        android:id="@+id/tv_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="已打钩: 周一白(D5), 周二白(F5)"
        android:textSize="12sp"
        android:textColor="@color/text_main" />

    <!-- 14 个班次快捷打钩选择网格 (7列 x 2行) -->
    <GridLayout
        android:id="@+id/grid_shifts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="7"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="false" />

</LinearLayout>
