#!/bin/sh /etc/rc.common
# 路由器上的应用内更新服务 (procd)：安装到 /etc/init.d/checkmark-update，脚本放在 /usr/share/checkmark-update/update_server.py
# 0.0.0.0:8080 供局域网 / tailnet / Funnel，127.0.0.1:8081 供樱花 frp 国内中转

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 -u /usr/share/checkmark-update/update_server.py 8080
	procd_set_param env SERVE_DIR=/mnt/usb/checkmark-update
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
