#!/bin/sh /etc/rc.common
# 路由器上的樱花 frp 客户端 (procd)：安装到 /etc/init.d/natfrp-frpc，可执行文件放在 /usr/share/natfrp/frpc (SakuraFrp linux_arm64 版)
# 国内中转 www.haa95d85b.nyat.app:19846 -> 127.0.0.1:8081 (checkmark-update)。同一隧道只能有一个客户端在线
# /etc/natfrp/frpc.env 里的 NATFRP_TOKEN / NATFRP_TARGET 替代 -f 启动参数，避免访问密钥出现在进程列表里；
# 同目录放该域名的证书与私钥，frpc 用它们终止 HTTPS

START=99
USE_PROCD=1

start_service() {
	. /etc/natfrp/frpc.env
	procd_open_instance
	# frpc 在工作目录里找证书，procd 没有设置工作目录的参数，所以经 sh 切过去
	procd_set_param command /bin/sh -c 'cd /etc/natfrp && exec /usr/share/natfrp/frpc'
	procd_set_param env NATFRP_TOKEN="$NATFRP_TOKEN" NATFRP_TARGET="$NATFRP_TARGET"
	procd_set_param respawn 3600 30 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
